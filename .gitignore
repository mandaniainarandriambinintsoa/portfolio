# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-stale-before-payload*/
/out/

# production
/build
/.payload/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.tmp-next-start-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Google service account key (sensitive)
service-account-key.json

# vercel
.vercel

# mcp config (contains local paths)
.mcp.json

# claude/agents local config
.claude/
.agents/
.serena/

# temp files & screenshots (root only)
/nul
/screen.png
/screenshot-fullpage.png
/code.html
/.tmp-analytics/
/.tmp-chrome-debug-profile*/
/.tmp-chrome-seo-verify*/
/*.PNG
/*.avif

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
